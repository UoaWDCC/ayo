# Cloudflare R2 (S3-compatible) storage for Payload media uploads
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
S3_BUCKET=ayo-media
S3_REGION=auto

# Public base URL for the R2 bucket — an r2.dev subdomain or a custom domain.
# Set it to serve media from Cloudflare's edge instead of proxying every file
# through /api/media/file/... on the Node server. Leave it unset to keep the
# proxied URLs (e.g. while developing against a private bucket).
R2_PUBLIC_URL=https://media.example.org
