# For production, use the Atlas driver URI with /ayo_prod before the query string.
DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Optional Instagram feed token. Leave empty until the client connection is approved.
INSTAGRAM_TOKEN=

# Backblaze B2 (S3-compatible) storage for Payload media uploads.
# Use the bucket's regional S3 endpoint without the bucket name in the URL.
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=ayo-media
# Use a bucket-scoped key with read and write access. These are keyID and
# applicationKey in Backblaze.
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY

# Leave unset for private buckets so Payload serves files at /api/media/file/.
# For Cloudflare R2, use its account endpoint and S3_REGION=auto. Set this
# optional URL only if the R2 bucket has a public media domain.
R2_PUBLIC_URL=
